{
  "name": "sso",
  "version": "0.0.1",
  "description": "Sistema de soporte a las operaciones",
  "scripts": {
    "back": "npm run dev --workspace=backend",
    "front": "npm run dev --workspace=frontend",
    "clientes": "npm run dev --workspace=clientes",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "startback": "npm run start --workspace=backend",
    "startfront": "npm run start --workspace=frontend"
  },
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "devDependencies": {
    "turbo": "^1.10.16"
  },
  "dependencies": {
    "install": "^0.13.0",
    "next": "^14.0.1",
    "npm": "^9.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  }
}
