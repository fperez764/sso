{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@*": ["./*", "./src/*"],
    },
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/auth/signin.js",
    "pages/api/auth/[...nextauth].js",
    ".next/types/**/*.ts"
, "src/components/trece/Feed.jsx", "../common/logger.ts"  ],
  "exclude": [
    "node_modules"
  ],
  "emitDecoratorMetadata": true,
  "experimentalDecorators": true,
  "sourceMap": true
}
